@using EPiServer.Framework.Web.Mvc.Html
@using EPiServer.Shell.Navigation
@addTagHelper *, EPiServer.Shell.UI
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Sitemaps</title>
</head>
<body>
    @* Tells the platform navigation how to send the antiforgery token below. Without it, its notification request fails. *@
    <episerver-common-settings></episerver-common-settings>
    @Html.AntiForgeryToken()
    <platform-navigation />
    <div id="root">
        <div id="container">
            @RenderBody()
        </div>
    </div>
</body>
</html>